# Server
PORT=5000
WEBSITE_URL=http://localhost:5173

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=123456
DB_NAME=nestjs

# JWT Configuration
JWT_SECRET=super_secret_key_cua_rieng_ban
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=super_refresh_secret_key_cua_rieng_ban
JWT_REFRESH_EXPIRES_IN=7d

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=backend-nodejs

# Redis Configuration
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD= your_password

# Email
EMAIL_USER=your_email
EMAIL_PASS=your_email_password

# Passport
SESSION_SECRET=your_session_secret_here
PASSPORT_URL_REDIRECT_SUCCESS=http://localhost:5173
PASSPORT_URL_REDIRECT_FAILED=/api/v1/auth/passport/failure
GOOGLE_CLIENT_ID=google_client_id
GOOGLE_CLIENT_SECRET=google_client_secret
GOOGLE_CALLBACK_URL=/api/v1/auth/google/callback

# Image Storage (ImgBB)
# Lấy key tại: https://api.imgbb.com/
IMGBB_API_KEY=your_api_key_here